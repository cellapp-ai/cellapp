{
  "name": "cellapp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/project.mjs build",
    "typecheck": "node scripts/project.mjs typecheck",
    "typecheck-browser": "tsc -p tsconfig.browser.json --noEmit",
    "test": "node scripts/project.mjs test",
    "dev": "go run ./apps/server/cmd/server",
    "cli": "node scripts/project.mjs cli",
    "migrate": "go run ./apps/server/cmd/server -migrate",
    "dev:web": "npm run dev --workspace @cellapp/web --",
    "preview:web": "npm run preview --workspace @cellapp/web --",
    "lint:web": "npm run lint --workspace @cellapp/web"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ]
}
