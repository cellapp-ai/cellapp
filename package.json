{
  "name": "ohmyapp",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/cli",
    "packages/shared"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && go build -o dist/ohmyapp-server ./apps/server/cmd/server",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts && go test ./apps/server/...",
    "dev": "go run ./apps/server/cmd/server",
    "cli": "tsx packages/cli/src/main.ts",
    "migrate": "go run ./apps/server/cmd/server -migrate"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "version": "0.1.0",
  "bin": {
    "ohmyapp": "dist/packages/cli/src/main.js"
  },
  "files": [
    "dist/packages",
    "skills/deploy-static-app",
    "README.md",
    "docs"
  ]
}
