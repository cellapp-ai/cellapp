{
  "name": "cellapp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/project.mjs build",
    "typecheck": "node scripts/project.mjs typecheck",
    "test": "node scripts/project.mjs test",
    "dev": "go run ./apps/server/cmd/server",
    "cli": "node scripts/project.mjs cli",
    "migrate": "go run ./apps/server/cmd/server -migrate",
    "dev:web": "npm run dev --workspace @cellapp/web --",
    "preview:web": "npm run preview --workspace @cellapp/web --",
    "lint:web": "npm run lint --workspace @cellapp/web",
    "build:website": "cd apps/website && corepack pnpm run build",
    "lint:website": "cd apps/website && corepack pnpm run lint",
    "preview:website": "cd apps/website && corepack pnpm run preview",
    "test:website": "cd apps/website && corepack pnpm run test",
    "check:app-api-versions": "node scripts/check-app-api-versions.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ]
}
