NODE_ENV=development
LISTEN_ADDRESS=0.0.0.0:3000
# Build apps/web before starting the service; deploy Go and this entire directory together.
WEB_ROOT=apps/web/dist
CONTROL_ORIGIN=https://control.localhost:8443
APPS_DOMAIN=apps.localhost
APP_PORT=8443
DATABASE_URL=postgres://cellapp:development@localhost:5432/cellapp
# Generate independently for production, at least 32 bytes; keep stable across restarts.
SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# dev signs in as one fixed local owner and is accepted only on localhost.
AUTH_MODE=dev
GITHUB_CLIENT_ID=replace-with-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-with-oauth-app-client-secret
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=cellapp
# Public local-development credentials only; inject real credentials through the process environment.
S3_ACCESS_KEY_ID=cellapp-local
S3_SECRET_ACCESS_KEY=cellapp-local-development-only
MAX_APPS=10
MAX_FILES=1000
MAX_FILE_BYTES=10000000
MAX_DEPLOYMENT_BYTES=50000000
MAX_STORAGE_BYTES=500000000
MAX_MONTHLY_TRAFFIC_BYTES=1000000000
MAX_REQUESTS_PER_MINUTE=120
UPLOAD_TTL_SECONDS=3600
RETENTION_SECONDS=86400
